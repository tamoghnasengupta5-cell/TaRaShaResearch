# Use "live" only after the TaRaShaData.ai backend and Pages Functions are configured.
# Any other value keeps the fictional, no-network review mode.
VITE_DATA_MODE=preview
VITE_API_BASE_URL=

# Server-only TaRaShaData.ai API connection used by local Vite middleware.
# Pages deployments should configure the same names as an environment variable
# and, when required, an encrypted secret. Never use a VITE_* key for credentials.
TARASHA_DATA_API_URL=http://127.0.0.1:8000
TARASHA_DATA_API_KEY=

# Server-only Admin reconciliation settings. Keep these out of VITE_* variables.
TARASHA_DATA_ADMIN_KEY=
# Optional local-only override when TaRaShaData is not in the usual sibling folder.
TARASHA_DATA_ENV_PATH=
CONSUMER_ADMIN_PASSWORD=Admin@123
CONSUMER_AUTH_SECRET=

# Required only by `npm start`: a deployed Discover Pages origin whose
# /api/health response identifies a configured TaRaShaData.ai provider.
TARASHA_DISCOVER_API_ORIGIN=

# Optional localhost-only proxy target. This is read by Vite's development
# server and is not exposed through import.meta.env in browser code.
DEV_API_TARGET=
